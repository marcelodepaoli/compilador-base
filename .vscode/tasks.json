{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": { "reveal": "always", "panel": "shared", "clear": true },
  "tasks": [
    {
      "label": "Compilar Gramática (JavaCC)",
      "type": "shell",
      "command": "scripts\\build.bat gramatica",
      "problemMatcher": []
    },
    {
      "label": "Compilar Java",
      "type": "shell",
      "command": "scripts\\build.bat compilar",
      "problemMatcher": {
        "owner": "javac",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+\\.java):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Executar Parser",
      "type": "shell",
      "command": "scripts\\build.bat executar",
      "problemMatcher": []
    },
    {
      "label": "Build & Run",
      "dependsOn": ["Compilar Gramática (JavaCC)", "Compilar Java", "Executar Parser"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
